# Docker Compose reads this file after it is copied to .env.
# dotnet does not read .env; configure the connection string with user-secrets.
POSTGRES_DB=democraft
POSTGRES_USER=democraft
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
# For teammates on a trusted LAN/VPN, use the host's network IP or 0.0.0.0.
POSTGRES_BIND_ADDRESS=127.0.0.1
